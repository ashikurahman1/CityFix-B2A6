# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public base URL of this API (used for Google + Stripe redirect URLs)
APP_URL=http://localhost:5000
# Comma separated list of allowed origins, or * for any
CORS_ORIGIN=*

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cityfix?schema=public"

# ---------- JWT ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Google OAuth (GCP Console > APIs & Services > Credentials) ----------
# Authorized redirect URI: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=bdt

# ---------- Redis (optional - caching is skipped when empty) ----------
REDIS_URL=

# ---------- Cloudinary (optional - attachments are disabled when empty) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@cityfix.com
SEED_ADMIN_PASSWORD=Admin@12345
